(module
  (func-decl f [global]
    (params (param x))
    (block
      (if
        (binary < (ident x [local:0]) (int 0))
        (block
          (throw
            (call
              (ident ValueError [global])
                            (string
                (lit "bad"))))))
      (return
        (ident x [local:0]))))
  (func-decl g [global]
    (params)
    (block
      (return))))
