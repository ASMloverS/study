// T016 混算表逐格（02 §3.4）+ 相等/hash 归一（02 §6/§7）
print(1 + 1n)
print(1n + 1)
print(1n + 1n)
print(1 + 0.5)
print(1n + 0.5)
print(0.5 + 1n)
print(1 == 1n)
print(1n == 1.0)
print(1 == 1.0)
print(hash(1) == hash(1n))
print(hash(1n) == hash(1.0))
print(type(1 + 1n))
print(type(1n + 0.5))
print(2n ** 10)
print(2 ** 64 == 1n << 64)
